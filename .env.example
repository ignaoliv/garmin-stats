GARMIN_EMAIL=tu@email.com
GARMIN_PASSWORD=tu_contraseña

# Opcional — basemap estilo Strava.
# Strava usa OpenMapTiles; esa fuente pide API key. Con una key gratuita de
# MapTiler (100k tiles/mes) el mapa pasa a usar exactamente esos tiles.
# Sacala en https://cloud.maptiler.com/account/keys/ y pegala acá.
VITE_MAPTILER_KEY=

# Opcional — análisis del entrenamiento con Llama vía Cloudflare Workers AI.
# Se ejecuta en fetch/insights.py (servidor), NUNCA en el navegador: este token
# da acceso a la cuenta, a diferencia de la key de mapas.
# Account ID: dash.cloudflare.com → home de tu cuenta, barra lateral derecha.
# API Token:  dash.cloudflare.com/profile/api-tokens → Create Token,
#             permiso "Workers AI: Read".
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Opcional pero muy recomendable — tabla de composición de alimentos para el
# registro de comidas. Sin ella se usa DEMO_KEY, que limita a ~30 pedidos por
# hora: alcanza para probar y se agota con dos fotos. Es gratis y tarda un
# minuto: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=

# ─── Sólo si vas a publicarlo en Vercel ──────────────────────────────────────
# Con esto el panel queda accesible desde el teléfono y se sincroniza solo una
# vez por día. Si lo vas a usar únicamente en tu computadora, dejalas vacías.

# La contraseña con la que entrás al panel publicado. La elegís vos, no tiene
# nada que ver con la de Garmin. Con ella se firma la cookie de sesión, así que
# cambiarla cierra todas las sesiones abiertas.
SITE_PASSWORD=

# Vercel Blob: donde viven tus datos una vez publicado. Se crea en el panel de
# Vercel (Storage → Create → Blob) y el token aparece en su pestaña .env.local.
# Ojo: `vercel env pull` NO lo trae, hay que copiarlo del panel a mano.
BLOB_READ_WRITE_TOKEN=

# Un secreto cualquiera y largo, para que sólo la tarea programada de Vercel
# pueda disparar la sincronización. Va aparte de SITE_PASSWORD a propósito:
# rotar una no obliga a rotar la otra. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
