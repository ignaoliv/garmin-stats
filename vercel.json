{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/|assets/|data/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "regions": [
    "iad1"
  ],
  "functions": {
    "api/comida/analizar.py": {
      "maxDuration": 60
    },
    "api/objetivo/brief.py": {
      "maxDuration": 60
    }
  }
}
