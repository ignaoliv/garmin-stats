{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/|assets/|data/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "regions": [
    "iad1"
  ],
  "functions": {
    "api/comida/analizar.py": {
      "maxDuration": 60
    },
    "api/objetivo/brief.py": {
      "maxDuration": 60
    },
    "api/sincronizar.py": {
      "maxDuration": 300
    },
    "api/pantalla/analizar.py": {
      "maxDuration": 60
    },
    "api/comida/texto.py": {
      "maxDuration": 60
    },
    "api/comida/alimento.py": {
      "maxDuration": 30
    },
    "api/plan/generar.py": {
      "maxDuration": 120
    },
    "api/perfil.ts": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/sincronizar",
      "schedule": "0 11 * * *"
    }
  ]
}
